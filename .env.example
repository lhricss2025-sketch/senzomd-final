# ═══════════════════════════════════════════════════════════════
# SENZO MD — Environment variables
# Copy this file to .env for local development, or set the same
# variables in your Railway project dashboard (Variables tab).
# NEVER commit a real .env file.
# ═══════════════════════════════════════════════════════════════

# ── WhatsApp ──
# Bot owner's phone number in international format (no +, no spaces)
OWNER_NUMBER=923021142153
# Display name of the bot in menus
BOT_NAME=SENZO MD
# Command prefix (default: .)
PREFIX=.
# Owner's WhatsApp channel URL/ID (auto-join + menu footer)
CHANNEL_URL=https://www.whatsapp.com/channel/0029VbBdHQnKWEKtmxS7XZ09

# ── Telegram (REQUIRED for the Telegram admin panel + pairing system) ──
# Get a token from @BotFather. If this is empty, Telegram is disabled and
# the bot runs in WhatsApp-only mode (no crash).
TG_TOKEN=
# Your Telegram chat/group ID — grants access to the admin panel.
# Find yours by messaging the bot and sending /myid once it runs.
ADMIN_CHAT_ID=

# ── Optional ──
# OWNER_HANDLE=@Senzo268
# OWNER_NAME=Senzo
# CHANNEL_HANDLE=Senzo Channel
